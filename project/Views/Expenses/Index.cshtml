@model MvcMovie.Models.ExpenseIndexViewModel

@{
    ViewData["Title"] = "Lista wydatkow";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <p class="text-uppercase text-muted fw-bold mb-1">System monitorowania wydatkow domowych</p>
        <h1>Lista wydatkow</h1>
    </div>
    <div class="border rounded bg-light p-3 text-end">
        <span class="text-muted d-block">Suma</span>
        <strong class="fs-4 text-success">@Model.Total.ToString("0.00") zl</strong>
    </div>
</div>

<form asp-action="Index" method="get" class="row g-3 align-items-end border rounded bg-white p-3 mb-4">
    <div class="col-md-4">
        <label class="form-label fw-bold">Szukaj</label>
        <input class="form-control" type="search" name="searchString" value="@Model.SearchString" placeholder="np. zakupy" />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold">Kategoria</label>
        <select class="form-select" name="categoryId" asp-items="Model.Categories">
            <option value="">Wszystkie</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold">Platnosc</label>
        <select class="form-select" name="paymentMethodId" asp-items="Model.PaymentMethods">
            <option value="">Wszystkie</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Filtruj</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Wyczysc</a>
    </div>
</form>

<p>
    <a class="btn btn-primary" asp-action="Create">Dodaj wydatek</a>
</p>

<div class="table-responsive border rounded bg-white">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Nazwa</th>
                <th>Kategoria</th>
                <th>Metoda</th>
                <th>Data</th>
                <th>Kwota</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Expenses)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                </td>
                <td>
                    <span class="badge rounded-pill" style="background-color:@item.Category?.Color">@item.Category?.Name</span>
                </td>
                <td>@item.PaymentMethod?.Name</td>
                <td>@item.SpentOn.ToString("yyyy-MM-dd")</td>
                <td class="fw-bold">@item.Amount.ToString("0.00") zl</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edytuj</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Usun</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
