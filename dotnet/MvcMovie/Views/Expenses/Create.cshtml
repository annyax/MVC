@model MvcMovie.Models.Expense

@{
    ViewData["Title"] = "Nowy wydatek";
}

<h1>Nowy wydatek</h1>

<form asp-action="Create" class="row g-3 border rounded bg-white p-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_ExpenseForm" model="Model" />
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Dodaj wydatek</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Anuluj</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
