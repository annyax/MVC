@model MvcMovie.Models.Expense

@{
    ViewData["Title"] = "Szczegoly wydatku";
}

<div class="border rounded bg-white p-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <p class="text-uppercase text-muted fw-bold mb-1">Widok pojedynczego obiektu</p>
            <h1>@Model.Title</h1>
        </div>
        <strong class="fs-3 text-success">@Model.Amount.ToString("0.00") zl</strong>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Kategoria</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>

        <dt class="col-sm-3">Metoda platnosci</dt>
        <dd class="col-sm-9">@Model.PaymentMethod?.Name</dd>

        <dt class="col-sm-3">Data</dt>
        <dd class="col-sm-9">@Model.SpentOn.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Notatka</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Note) ? "Brak notatki" : Model.Note)</dd>
    </dl>

    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edytuj</a>
    <a class="btn btn-outline-secondary" asp-action="Index">Powrot</a>
</div>
