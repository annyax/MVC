@model MvcMovie.Models.Expense

<div class="col-md-6">
    <label asp-for="Title" class="form-label fw-bold">Nazwa</label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="col-md-6">
    <label asp-for="Amount" class="form-label fw-bold">Kwota</label>
    <input asp-for="Amount" class="form-control" min="0.01" step="0.01" />
    <span asp-validation-for="Amount" class="text-danger"></span>
</div>

<div class="col-md-6">
    <label asp-for="SpentOn" class="form-label fw-bold">Data</label>
    <input asp-for="SpentOn" class="form-control" type="date" />
    <span asp-validation-for="SpentOn" class="text-danger"></span>
</div>

<div class="col-md-6">
    <label asp-for="CategoryId" class="form-label fw-bold">Kategoria</label>
    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
</div>

<div class="col-md-6">
    <label asp-for="PaymentMethodId" class="form-label fw-bold">Metoda platnosci</label>
    <select asp-for="PaymentMethodId" class="form-select" asp-items="ViewBag.PaymentMethodId"></select>
    <span asp-validation-for="PaymentMethodId" class="text-danger"></span>
</div>

<div class="col-12">
    <label asp-for="Note" class="form-label fw-bold">Notatka</label>
    <textarea asp-for="Note" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Note" class="text-danger"></span>
</div>
